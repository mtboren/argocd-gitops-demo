{
  "image": "mcr.microsoft.com/devcontainers/go",
  "features": {
    "ghcr.io/devcontainers/features/powershell:latest": {
      "modules": [
        "posh-git"
      ]
    },
    // region -- kind pre-reqs / install
    // Install Docker-in-Docker so kind can spin up cluster containers
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {
      "moby": false,
      "version": "latest"
    },
    // Install kubectl and helm to interact with your cluster
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "installMinikube": false
    }
    // endregion  
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "/usr/bin/pwsh"
          }
        }
      }
    }
  },
  "portsAttributes": {
    // make it such that this forwarded port is accessible via https, so consumer need not hassle with changing that in the Codespaces UI themselves (nor need to know about it)
    "8080": {
      "label": "Argo CD UI",
      "protocol": "https",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": {
    "kindInstall": "[ $(uname -m) = x86_64 ] && curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.32.0/kind-linux-amd64 && chmod +x ./kind && sudo mv ./kind /usr/local/bin/kind",
    "addPoshGitToPSProfile": "pwsh -NoLogo -NoProfile -Command 'Add-PoshGitToProfile'"
  }
}
